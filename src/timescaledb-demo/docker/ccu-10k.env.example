# 10k+ CCU profile for short-lived web/mobile transactions via PgBouncer transaction pooling.
# Adjust these numbers to your actual CPU, RAM, disk IOPS, and workload before production rollout.

POSTGRES_DB=timescale_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

TIMESCALE_IMAGE=timescale/timescaledb:latest-pg17
TIMESCALEDB_TELEMETRY=off
TIMESCALE_TUNE_MEMORY=16GB
TIMESCALE_TUNE_NUM_CPUS=4
TIMESCALE_TUNE_MAX_BG_WORKERS=16
TIMESCALE_TUNE_MAX_CONNS=300
TIMESCALE_SHM_SIZE=4gb
TIMESCALE_NOFILE_SOFT=65535
TIMESCALE_NOFILE_HARD=65535

PGBOUNCER_MAX_CLIENT_CONN=20000
PGBOUNCER_DEFAULT_POOL_SIZE=200
PGBOUNCER_MIN_POOL_SIZE=50
PGBOUNCER_RESERVE_POOL_SIZE=50
PGBOUNCER_RESERVE_POOL_TIMEOUT=2
PGBOUNCER_MAX_DB_CONNECTIONS=250
PGBOUNCER_MAX_DB_CLIENT_CONNECTIONS=20000
PGBOUNCER_QUERY_WAIT_TIMEOUT=30
PGBOUNCER_SERVER_IDLE_TIMEOUT=30
PGBOUNCER_SERVER_LIFETIME=1800
PGBOUNCER_LISTEN_BACKLOG=8192
PGBOUNCER_NOFILE_SOFT=262144
PGBOUNCER_NOFILE_HARD=262144
PGBOUNCER_SOMAXCONN=8192
