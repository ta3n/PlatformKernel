{
  "App": {
    "appName": "Employee WebApi",
    "AppVersion": "0.0.1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "InMemoryDatabase": "Liberty.Reservation.Employee.WebAPI",
    "MigrationsAssembly": "Liberty.Reservation.Employee.WebAPI",
    "DataContextConnection": "server=localhost;port=3309;userid=user;password=password;database=reservation"
  },
  "ConnectionPool": {
    "MaximumNumberOfConcurrentEntries": 10,
    "Enabled": true
  },
  "Cors": {
    "PolicyName": "MyOrigins",
    "AllowedOrigins": "*",
    "AllowedMethods": "*",
    "AllowedHeaders": "*",
    "ExposedHeaders": "Authorization,Link,X-Total-Count,X-Pagination",
    "AllowCredentials": true,
    "MaxAge": 1800
  },
  "ConcurrencyLimiter": {
    "Enabled": false,
    "MaxConcurrentRequests": 4,
    "RequestQueueLimit": 10
  },
  "HttpClientPolicy": {
    "Enabled": false,
    "Timeout": 20,
    "Retry": 5,
    "ExceptionsAllowedBeforeBreaking": 3,
    "BreakDuration": 20
  },
  "AllowedHosts": "*"
}
