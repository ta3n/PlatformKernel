{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TickerQConnection": "Host=localhost;Port=5432;Database=tickerq_test;Username=postgres;Password=postgres"
  },
  "TickerQStorage": {
    "Provider": "EntityFramework",
    "ConnectionStringName": "TickerQConnection",
    "CancelMissedTickersOnRestart": true,
    "UseModelCustomizerForMigrations": true,
    "Redis": {
      "ConnectionString": "localhost:6379",
      "Database": 1,
      "Prefix": "tickerq:test:"
    }
  },
  "TickerQServer": {
    "Enabled": true,
    "MaxConcurrency": 4,
    "DefaultRetries": 3,
    "DefaultRetryIntervalsInSeconds": [
      60,
      120,
      300
    ],
    "BootstrapLockName": "tickerq:bootstrap",
    "BootstrapLockTimeoutInSeconds": 180
  },
  "TickerQDashboard": {
    "Enabled": true,
    "DashboardUrl": "tickerq-dashboard",
    "EnableBasicAuth": true,
    "Username": "admin",
    "Password": "admin",
    "IsReadOnly": false
  }
}
