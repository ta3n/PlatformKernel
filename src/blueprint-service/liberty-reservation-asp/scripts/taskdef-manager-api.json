{
  "family": "__TASK_DEFINITION_FAMILY__",
  "containerDefinitions": [
    {
      "name": "__CONTAINER_NAME__",
      "image": "__ECR_IMAGE__",
      "portMappings": [
        {
          "containerPort": "__CONTAINER_PORT__",
          "hostPort": "__CONTAINER_PORT__",
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-stream-prefix": "__CONTAINER_NAME__"
        }
      },
      "essential": true,
      "secrets": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_ENVIRONMENT::"
        },
        {
          "name": "ASPNETCORE_URLS",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_URLS::"
        },
        {
          "name": "ConnectionStrings__DataContextConnection",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__ConnectionStrings__DataContextConnection::"
        },
        {
          "name": "Identity__Jwt__Authority",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ManagerAuthority::"
        },
        {
          "name": "Identity__AccessCode__Code",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ManagerAuthorityAccessCode::"
        },
        {
          "name": "SmtpMail__Name",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Name::"
        },
        {
          "name": "SmtpMail__Mail",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Mail::"
        },
        {
          "name": "SmtpMail__UserName",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__UserName::"
        },
        {
          "name": "SmtpMail__Smtp",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Smtp::"
        },
        {
          "name": "SmtpMail__SmtpPort",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__SmtpPort::"
        },
        {
          "name": "SmtpMail__Password",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Password::"
        },
        {
          "name": "GMOPayment__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__Enabled::"
        },
        {
          "name": "GMOPayment__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__Url::"
        },
        {
          "name": "GMOPayment__PaymentHost",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__PaymentHost::"
        },
        {
          "name": "GMOPayment__ShopID",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__ShopID::"
        },
        {
          "name": "GMOPayment__ShopPassword",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__ShopPassword::"
        },
        {
          "name": "GMOPayment__JobCd",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__JobCd::"
        },
        {
          "name": "GMOPayment__OrderDateFormat",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__OrderDateFormat::"
        },
        {
          "name": "GMOPayment__UseCredit",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__UseCredit::"
        },
        {
          "name": "GMOPayment__Expire",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:GMOPayment__Expire::"
        },
        {
          "name": "Services__MembershipFacilityService__DataContextConnection",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Services__MembershipFacilityService__DataContextConnection::"
        },
        {
          "name": "Services__MembershipFacilityService__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MembershipFacilityUrl::"
        },
        {
          "name": "Services__MembershipFacilityService__AccessCode",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MembershipFacilityAccessCode::"
        },
        {
          "name": "Services__ReservationEmployeeService__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Services__ReservationEmployeeService__Url::"
        },
        {
          "name": "Services__ReservationEmployeeService__AccessCode",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Services__ReservationEmployeeService__AccessCode::"
        },
        {
          "name": "Services__BatchSchedulerService__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Services__BatchSchedulerService__Url::"
        },
        {
          "name": "Services__BatchSchedulerService__AccessCode",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Services__BatchSchedulerService__AccessCode::"
        },
        {
          "name": "Redis__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:RedisEnabled::"
        },
        {
          "name": "Redis__UrlConfiguration",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:RedisConnectionString::"
        },
        {
          "name": "Cors__AllowedOrigins",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Cors__AllowedOrigins::"
        },
        {
          "name": "Cors__AllowedMethods",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Cors__AllowedMethods::"
        },
        {
          "name": "Cors__AllowedHeaders",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Cors__AllowedHeaders::"
        },
        {
          "name": "Cors__ExposedHeaders",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Cors__ExposedHeaders::"
        },
        {
          "name": "SentryMonitoring__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__SentryMonitoring__Enabled::"
        },
        {
          "name": "SentryMonitoring__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__SentryMonitoring__Dsn::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__SerilogLogging__WriteToSentry__Enabled::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__SerilogLogging__WriteToSentry__Dsn::"
        },
        {
          "name": "MailTemplate__ApplicationName",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MailTemplateApplicationName::"
        },
        {
          "name": "MailTemplate__ManagerUrl",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MailTemplateManagerUrl::"
        },
        {
          "name": "MailTemplate__UserUrl",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MailTemplateUserUrl::"
        },
        {
          "name": "MailTemplate__GuestUrl",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MailTemplateGuestUrl::"
        },
        {
          "name": "SecretKey__HmacSecretKey",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__SecretKey__HmacSecretKey::"
        }
      ]
    }
  ],
  "taskRoleArn": "__TASK_ROLE__",
  "executionRoleArn": "__EXECUTION_ROLE__",
  "cpu": "__TASK_EXECUTION_CPU__",
  "memory": "__TASK_EXECUTION_MEMORY__",
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["FARGATE"]
}
