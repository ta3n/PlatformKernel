{
  "family": "__TASK_DEFINITION_FAMILY__",
  "containerDefinitions": [
    {
      "name": "__CONTAINER_NAME__",
      "image": "__ECR_IMAGE__",
      "portMappings": [
        {
          "containerPort": "__CONTAINER_PORT__",
          "hostPort": "__CONTAINER_PORT__",
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-stream-prefix": "__CONTAINER_NAME__"
        }
      },
      "essential": true,
      "secrets": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_ENVIRONMENT::"
        },
        {
          "name": "ASPNETCORE_URLS",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_URLS::"
        },
        {
          "name": "ConnectionStrings__DataContextConnection",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__ConnectionStrings__DataContextConnection::"
        },
        {
          "name": "Identity__Jwt__Authority",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ManagerAuthority::"
        },
        {
          "name": "Identity__Jwt__ClientId",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Identity__Jwt__ClientId::"
        },
        {
          "name": "Identity__Jwt__ClientSecret",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Identity__Jwt__ClientSecret::"
        },
        {
          "name": "Identity__Jwt__Scope",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Identity__Jwt__Scope::"
        },
        {
          "name": "Identity__AccessCode__Code",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ManagerAuthorityAccessCode::"
        },
        {
          "name": "Services__MembershipFacilityService__DataContextConnection",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Services__MembershipFacilityService__DataContextConnection::"
        },
        {
          "name": "Services__MembershipFacilityService__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MembershipFacilityUrl::"
        },
        {
          "name": "Services__MembershipFacilityService__AccessCode",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MembershipFacilityAccessCode::"
        },
        {
          "name": "Services__SiteService__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Services__SiteService__Url::"
        },
        {
          "name": "Services__SiteService__GrpcUrl",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Services__SiteService__GrpcUrl::"
        },
        {
          "name": "Redis__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:RedisEnabled::"
        },
        {
          "name": "Redis__UrlConfiguration",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:RedisConnectionString::"
        },
        {
          "name": "Cors__AllowedOrigins",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Cors__AllowedOrigins::"
        },
        {
          "name": "Cors__AllowedMethods",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Cors__AllowedMethods::"
        },
        {
          "name": "Cors__AllowedHeaders",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Cors__AllowedHeaders::"
        },
        {
          "name": "Cors__ExposedHeaders",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__Cors__ExposedHeaders::"
        },
        {
          "name": "SentryMonitoring__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__SentryMonitoring__Enabled::"
        },
        {
          "name": "SentryMonitoring__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__SentryMonitoring__Dsn::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__SerilogLogging__WriteToSentry__Enabled::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__SerilogLogging__WriteToSentry__Dsn::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Url::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Username",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Username::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Password",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Password::"
        },
        {
          "name": "GrpcClientPolicy__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Manager__Distribution__GrpcClientPolicy__Enabled::"
        }
      ]
    }
  ],
  "taskRoleArn": "__TASK_ROLE__",
  "executionRoleArn": "__EXECUTION_ROLE__",
  "cpu": "__TASK_EXECUTION_CPU__",
  "memory": "__TASK_EXECUTION_MEMORY__",
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["FARGATE"]
}
