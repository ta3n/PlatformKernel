{
  "family": "__TASK_DEFINITION_FAMILY__",
  "containerDefinitions": [
    {
      "name": "__CONTAINER_NAME__",
      "image": "__ECR_IMAGE__",
      "portMappings": [
        {
          "containerPort": "__CONTAINER_PORT__",
          "hostPort": "__CONTAINER_PORT__",
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-stream-prefix": "__CONTAINER_NAME__"
        }
      },
      "essential": true,
      "secrets": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_ENVIRONMENT::"
        },
        {
          "name": "ASPNETCORE_URLS",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:ASPNETCORE_URLS::"
        },
        {
          "name": "SmtpMail__Name",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Name::"
        },
        {
          "name": "SmtpMail__Mail",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Mail::"
        },
        {
          "name": "SmtpMail__UserName",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__UserName::"
        },
        {
          "name": "SmtpMail__Smtp",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Smtp::"
        },
        {
          "name": "SmtpMail__SmtpPort",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__SmtpPort::"
        },
        {
          "name": "SmtpMail__Password",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:SmtpMail__Password::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Url",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Url::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Username",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Username::"
        },
        {
          "name": "MessageQueueSettings__RabbitMqOptions__Password",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:MessageQueueSettings__RabbitMqOptions__Password::"
        },
        {
          "name": "SentryMonitoring__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Mail__Worker__SentryMonitoring__Enabled::"
        },
        {
          "name": "SentryMonitoring__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Mail__Worker__SentryMonitoring__Dsn::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Enabled",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Mail__Worker__SerilogLogging__WriteToSentry__Enabled::"
        },
        {
          "name": "SerilogLogging__WriteToSentry__Dsn",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:Mail__Worker__SerilogLogging__WriteToSentry__Dsn::"
        },
        {
          "name": "FaxImo__ApiUrl",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:FaxImo__ApiUrl::"
        },
        {
          "name": "FaxImo__UserName",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:FaxImo__UserName::"
        },
        {
          "name": "FaxImo__UserKey",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:FaxImo__UserKey::"
        },
        {
          "name": "FaxImo__Password",
          "valueFrom": "__RUNTIME_SECRETS_MANAGER_ARN__:FaxImo__Password::"
        }
      ]
    }
  ],
  "taskRoleArn": "__TASK_ROLE__",
  "executionRoleArn": "__EXECUTION_ROLE__",
  "cpu": "__TASK_EXECUTION_CPU__",
  "memory": "__TASK_EXECUTION_MEMORY__",
  "networkMode": "awsvpc",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["FARGATE"]
}
