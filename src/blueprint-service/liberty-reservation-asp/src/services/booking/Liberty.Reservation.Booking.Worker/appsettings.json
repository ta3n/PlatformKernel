    "DataContextConnection": "Server=localhost;Port=5435;Database=liberty_reservation;User id=postgres;Pwd=;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=15;Connection Idle Lifetime=300;"
  },
  "MessageQueueSettings": {
    "QueueType": "RabbitMq",
    "RabbitMqOptions": {
      "Url": "amqp://localhost",
      "Username": "",
      "Password": ""
    }
  },
  "Services": {
    "BatchSchedulerService": {
      "ServiceName": "Batch scheduler service",
      "Url": "http://localhost:5162",
      "AccessCode": ""
    },
    "ReservationSiteService": {
      "ServiceName": "Reservation site service",
      "Url": "http://localhost:7088"
    }
  },
  "Redis": {
    "Enabled": true,
    "UrlConfiguration": "localhost:6379,password=",
    "InstanceName": "L:Res:Mng:",
    "SlidingExpirationInSecond": 3600
  },
  "SentryMonitoring": {
    "Enabled": false,
    "Dsn": ""
  },
  "SerilogLogging": {
    "Enabled": true,
    "WriteToConsole": true,
    "WriteToFile": false,
    "WriteToSeq": {
      "Enabled": false,
      "Url": "http://localhost:5340/",
      "ApiKey": "01jErQ4kB7D11e78TyX92WqBN8"
    },
    "WriteToSentry": {
      "Enabled": false,
      "Dsn": ""
    },
    "WriteToAwsCloudWatch": {
      "Enabled": false,
      "LogGroupName": "",
      "LogStreamPrefix": "",
      "AwsSetting": {
        "AccessKeyId": "",
        "SecretAccessKey": ""
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
