  "ConcurrencyLimiter": {
    "Enabled": false,
    "MaxConcurrentRequests": 4,
    "RequestQueueLimit": 10
  },
  "HttpClientPolicy": {
    "Enabled": false,
    "Timeout": 20,
    "Retry": 5,
    "ExceptionsAllowedBeforeBreaking": 3,
    "BreakDuration": 20
