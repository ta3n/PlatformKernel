<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.7" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.GmoPaymentGateway\Liberty.GmoPaymentGateway.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.Grpc\Liberty.Grpc.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.Hangfire\Liberty.Hangfire.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.Pagination\Liberty.Pagination.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.SysIntegrationEvent\Liberty.SysIntegrationEvent.csproj" />
    <ProjectReference Include="..\..\..\modules\Liberty.Reservation.Application\Liberty.Reservation.Application.csproj" />
    <ProjectReference Include="..\Liberty.Reservation.Site.Application\Liberty.Reservation.Site.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\liberty-asp\Proto\**\*.proto" Link="Protos\%(RecursiveDir)%(Filename)%(Extension)" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />

    <Protobuf Update="..\..\..\liberty-asp\Proto\common\**\*.proto" GrpcServices="None" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />
    <Protobuf Update="..\..\..\liberty-asp\Proto\site\v1\site_model.proto" GrpcServices="None" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />
    <Protobuf Update="..\..\..\liberty-asp\Proto\site\v1\site_request.proto" GrpcServices="None" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />
    <Protobuf Update="..\..\..\liberty-asp\Proto\site\v1\site_response.proto" GrpcServices="None" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />

    <Protobuf Update="..\..\..\liberty-asp\Proto\site\v1\site_endpoint.proto" GrpcServices="Server,Client" AdditionalImportDirs="..\..\..\liberty-asp\Proto\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localizes\Resources\Errors\I18n.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>I18n.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizes\Resources\I18n.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>I18n.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Remove="Localizes\**" />
    <EmbeddedResource Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="obj\Debug\" />
    <Folder Include="UserCases\Commands\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Localizes\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Localizes\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
