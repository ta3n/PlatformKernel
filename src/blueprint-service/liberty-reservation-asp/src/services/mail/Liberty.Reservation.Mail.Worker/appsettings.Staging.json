{
  "App": {
    "appName": "Mail Worker",
    "AppVersion": "0.1.17"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "Enabled": true,
    "UrlConfiguration": "localhost:6379,password=",
    "InstanceName": "Liberty:Reservation:Manager:",
    "SlidingExpirationInSecond": 3600
  },
  "MessageQueueSettings": {
    "QueueType": "RabbitMq",
    "RabbitMqOptions": {
      "Url": "amqp://localhost",
      "Username": "",
      "Password": ""
    }
  },
  "SentryMonitoring": {
    "Enabled": false,
    "Dsn": ""
  },
  "SerilogLogging": {
    "Enabled": true,
    "WriteToConsole": true,
    "WriteToFile": false,
    "WriteToSeq": {
      "Enabled": false,
      "Url": "http://localhost:5340/",
      "ApiKey": "01jErQ4kB7D11e78TyX92WqBN8"
    },
    "WriteToSentry": {
      "Enabled": false,
      "Dsn": ""
    },
    "WriteToAwsCloudWatch": {
      "Enabled": false,
      "LogGroupName": "",
      "LogStreamPrefix": "",
      "AwsSetting": {
        "AccessKeyId": "",
        "SecretAccessKey": ""
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    }
  },
  "ConnectionPool": {
    "MaximumNumberOfConcurrentEntries": 20,
    "Enabled": true
  },
  "Cors": {
    "PolicyName": "MyOrigins",
    "AllowedOrigins": "*",
    "AllowedMethods": "GET,POST,PUT,PATCH,DELETE",
    "AllowedHeaders": "*",
    "ExposedHeaders": "*",
    "AllowCredentials": true,
    "MaxAge": 1800
  },
  "ConcurrencyLimiter": {
    "Enabled": false,
    "MaxConcurrentRequests": 4,
    "RequestQueueLimit": 10
  },
  "HttpClientPolicy": {
    "Enabled": false,
    "Timeout": 20,
    "Retry": 5,
    "ExceptionsAllowedBeforeBreaking": 3,
    "BreakDuration": 20
  },
  "SmtpMail": {
    "Name": "[develop]リバティー予約システム",
    "Mail": "membership-develop-liberty@liberty-hp2.com",
    "UserName": "membership-develop-liberty@liberty-hp2.com",
    "Smtp": "smtp.lolipop.jp",
    "SmtpPort": 465,
    "Password": ""
  },
  "FaxImo": {
    "ApiUrl": "https://rest.faximo.jp/snd/v2/request.json",
    "UserName": "",
    "UserKey": "",
    "Password": ""
  }
}
