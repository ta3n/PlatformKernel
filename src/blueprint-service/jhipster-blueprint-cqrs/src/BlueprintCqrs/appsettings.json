{
  "Serilog": {
    "MinimumLevel": "Information",
    "Override": {
      "Default": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "SyslogUrl": "localhost",
    "SyslogPort": "6514",
    "SyslogAppName": "BlueprintCqrs",
    "Enrich": [
      "FromLogContext",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "EntityFramework": {
    "DataSource": ":memory:"
  },
  "Security": {
    "Authentication": {
      "Jwt": {
        "Base64Secret": "NTFkZWQ3MmNkMWU5OTYzZTM3MzYxNTIzNTZkNzg2ZmE3ZDQ0ZjkxMzE3YjllMjhmMDRhNGQ2ZmM2ZDQ5MzgzOGNhM2ZjZWJlNDU5YmJmMGI3MzI2MWY3NTgzZDUwMzdiNWVjZQ==",
        "TokenValidityInSeconds": 86400,
        "TokenValidityInSecondsForRememberMe": 2592000
      }
    },
    "Cors": {
      "AllowedOrigins": "*",
      "AllowedMethods": "*",
      "AllowedHeaders": "*",
      "ExposedHeaders": "Authorization,Link,X-Total-Count,X-Pagination",
      "AllowCredentials": true,
      "MaxAge": 1800
    }
  },
  "RibbonInfo": {
    "display-ribbon-on-profiles": "dev"
  }
}
