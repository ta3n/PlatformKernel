<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmployeeSecretsId>034430d5-791e-4385-bc2e-0ebd93fc7531</EmployeeSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <!-- Turn on R2R and composite for release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <!-- Add option -->
    <!-- <PublishReadyToRunEmitSymbols>true</PublishReadyToRunEmitSymbols> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="HttpClientToCurl" Version="2.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.6" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.Pagination\Liberty.Pagination.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.SentrySelfHosted\Liberty.SentrySelfHosted.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.Serilog\Liberty.Serilog.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.ServiceDefaults\Liberty.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\liberty-asp\Liberty.SysException\Liberty.SysException.csproj" />
  </ItemGroup>

</Project>
